doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title #{title} — Anime Collection
    link(rel="stylesheet" href="/css/style.css")
  body
    header.site-header
      a.brand(href="/") 🎬 Anime Collection
      .nav-actions
        a.btn(href="/add") + Add anime
        if user
          span.user-badge 👤 #{user.username}
          form.logout-form(action="/logout" method="POST")
            button.linkbtn(type="submit") Log out
        else
          a.loginlink(href="/login") Log in
    main.container
      block content
    footer.site-footer
      p Built with Express + Pug + sessions · CST8326 · The Web Archipelago
